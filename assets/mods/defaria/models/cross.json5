// Two quads crossed diagonally through the block, for plants. Each quad is
// two faces back to back, so it shows from both sides. They're inside the
// block, so they're never hidden, and they're lit by the block's own voxel.
// It covers no side, so light passes through and its neighbours' faces
// show, and there's nothing to bump into. The crosshair picks a box
// around the middle of the quads, as high as the plants on it grow, so you
// can aim past one at what's behind it.
{
  slots: { all: null },
  occludes: [],
  collision: [],
  target: [{ from: [0.125, 0, 0.125], to: [0.875, 0.875, 0.875] }],
  faces: [
    {
      texture: "all",
      vertices: [
        { pos: [0, 0, 0], uv: [0, 1] },
        { pos: [1, 0, 1], uv: [1, 1] },
        { pos: [1, 1, 1], uv: [1, 0] },
        { pos: [0, 1, 0], uv: [0, 0] },
      ],
    },
    {
      texture: "all",
      vertices: [
        { pos: [1, 0, 1], uv: [0, 1] },
        { pos: [0, 0, 0], uv: [1, 1] },
        { pos: [0, 1, 0], uv: [1, 0] },
        { pos: [1, 1, 1], uv: [0, 0] },
      ],
    },
    {
      texture: "all",
      vertices: [
        { pos: [1, 0, 0], uv: [0, 1] },
        { pos: [0, 0, 1], uv: [1, 1] },
        { pos: [0, 1, 1], uv: [1, 0] },
        { pos: [1, 1, 0], uv: [0, 0] },
      ],
    },
    {
      texture: "all",
      vertices: [
        { pos: [0, 0, 1], uv: [0, 1] },
        { pos: [1, 0, 0], uv: [1, 1] },
        { pos: [1, 1, 0], uv: [1, 0] },
        { pos: [0, 1, 1], uv: [0, 0] },
      ],
    },
  ],
}
