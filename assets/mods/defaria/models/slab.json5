// The bottom half of a block. Its sides show the bottom half of their
// texture, so they line up with the blocks around it. Its top is inside
// the block's space, so it's never hidden, and it's lit by the slab's own
// voxel. Only the bottom is covered completely, so light passes through
// every other side and stops at the bottom.
{
  slots: {
    all: null,
    side: "all",
    end: "all",
    up: "end",
    down: "end",
    north: "side",
    south: "side",
    east: "side",
    west: "side",
  },
  occludes: ["down"],
  // The box around the faces: [0, 0, 0] to [1, 0.5, 1].
  faces: [
    {
      texture: "east", cull: "east",
      vertices: [
        { pos: [1, 0, 1], uv: [0, 1] },
        { pos: [1, 0, 0], uv: [1, 1] },
        { pos: [1, 0.5, 0], uv: [1, 0.5] },
        { pos: [1, 0.5, 1], uv: [0, 0.5] },
      ],
    },
    {
      texture: "west", cull: "west",
      vertices: [
        { pos: [0, 0, 0], uv: [0, 1] },
        { pos: [0, 0, 1], uv: [1, 1] },
        { pos: [0, 0.5, 1], uv: [1, 0.5] },
        { pos: [0, 0.5, 0], uv: [0, 0.5] },
      ],
    },
    {
      texture: "up",
      vertices: [
        { pos: [0, 0.5, 1], uv: [0, 1] },
        { pos: [1, 0.5, 1], uv: [1, 1] },
        { pos: [1, 0.5, 0], uv: [1, 0] },
        { pos: [0, 0.5, 0], uv: [0, 0] },
      ],
    },
    {
      texture: "down", cull: "down",
      vertices: [
        { pos: [0, 0, 0], uv: [0, 1] },
        { pos: [1, 0, 0], uv: [1, 1] },
        { pos: [1, 0, 1], uv: [1, 0] },
        { pos: [0, 0, 1], uv: [0, 0] },
      ],
    },
    {
      texture: "south", cull: "south",
      vertices: [
        { pos: [0, 0, 1], uv: [0, 1] },
        { pos: [1, 0, 1], uv: [1, 1] },
        { pos: [1, 0.5, 1], uv: [1, 0.5] },
        { pos: [0, 0.5, 1], uv: [0, 0.5] },
      ],
    },
    {
      texture: "north", cull: "north",
      vertices: [
        { pos: [1, 0, 0], uv: [0, 1] },
        { pos: [0, 0, 0], uv: [1, 1] },
        { pos: [0, 0.5, 0], uv: [1, 0.5] },
        { pos: [1, 0.5, 0], uv: [0, 0.5] },
      ],
    },
  ],
}
