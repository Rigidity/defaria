{
  name: "{wood} Slab",
  properties: {
    // Which half of its voxel it fills: on top of a block it sits low,
    // under one it sits high, and against a block's side it sits low too.
    // Vertical slabs are blocks of their own (`*_vertical_slab`).
    half: {
      values: ["bottom", "top"],
      place: { from: "face", values: { up: "bottom", down: "top" } },
    },
    wood: { materials: "#wood", default: "oak" },
  },
  model: "slab_{half}",
  textures: { all: { texture: "planks", materials: { wood: "{wood}" } } },
  hardness: { materials: { wood: 1 } },
  weight: { base: 0.5, materials: { wood: 1 } },
  // Water fills the half of its cell it leaves.
  fluid_room: 0.5,
  category: "building",
}
