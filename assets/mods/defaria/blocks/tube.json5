    { when: { north: "false", east: "true", west: "true", up: "true", down: "true" }, model: "pipe_cap_cross" },
    { when: { south: "false", east: "false", west: "false", up: "false", down: "false" }, model: "pipe_cap_end", rotate: [0, 180, 0] },
