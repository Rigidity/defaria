    { when: { south: "false", east: "true", west: "false", up: "true", down: "true" }, model: "pipe_cap_tee", rotate: [0, 180, 0] },
    { when: { south: "false", east: "false", west: "true", up: "true", down: "true" }, model: "pipe_cap_tee", rotate: [180, 0, 0] },
    { when: { south: "false", east: "true", west: "true", up: "true", down: "true" }, model: "pipe_cap_cross", rotate: [0, 180, 0] },
    { when: { east: "false", north: "false", south: "false", up: "false", down: "false" }, model: "pipe_cap_end", rotate: [0, 270, 0] },
    { when: { east: "false", north: "true", south: "false", up: "false", down: "false" }, model: "pipe_cap", rotate: [0, 90, 180] },
    { when: { east: "false", north: "false", south: "true", up: "false", down: "false" }, model: "pipe_cap", rotate: [0, 270, 0] },
    { when: { east: "false", north: "true", south: "true", up: "false", down: "false" }, model: "pipe_cap", rotate: [0, 90, 180] },
