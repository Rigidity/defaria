// A metal pipe, on the fluid network: a square rod 6 pixels across
// through the middle of the block, a cube in the middle with an arm out to
// each side it's joined on, as thick as the cube. Its `connect` property
// becomes six, `north` to `down`, which the engine sets to whether the
// block on that side is on the same network kind (any conduit with
// `network: "fluid"` and no group), so pipes join the pipes they're placed
// next to and form one network. The middle cube's faces are drawn only on
// the sides it isn't joined on: the band running along an arm that passes
// them, or turning to each arm passing them where it bends, tees or
// crosses, or the pipe's end. scripts/pipe-models.py writes the models
// and this list of parts. Its layers are transparent around the pipe, so
// its faces are cut out.
{
  name: "{metal} Pipe",
  properties: {
    metal: { materials: "#metal", default: "iron" },
    connect: { connections: true },
  },
  textures: {
    side: { texture: "pipe_side", materials: { metal: "{metal}" } },
    end: { texture: "pipe_end", materials: { metal: "{metal}" } },
    bend: { texture: "pipe_bend", materials: { metal: "{metal}" } },
    tee: { texture: "pipe_tee", materials: { metal: "{metal}" } },
    cross: { texture: "pipe_cross", materials: { metal: "{metal}" } },
  },
  parts: [
    { model: "pipe_core" },
    { when: { north: "true" }, model: "pipe_arm" },
    { when: { south: "true" }, model: "pipe_arm", rotate: [0, 180, 0] },
    { when: { east: "true" }, model: "pipe_arm", rotate: [0, 270, 0] },
    { when: { west: "true" }, model: "pipe_arm", rotate: [0, 90, 0] },
    { when: { up: "true" }, model: "pipe_arm", rotate: [90, 0, 0] },
    { when: { down: "true" }, model: "pipe_arm", rotate: [270, 0, 0] },
    { when: { north: "false", east: "false", west: "false", up: "false", down: "false" }, model: "pipe_cap_end" },
    { when: { north: "false", east: "true", west: "false", up: "false", down: "false" }, model: "pipe_cap" },
    { when: { north: "false", east: "false", west: "true", up: "false", down: "false" }, model: "pipe_cap", rotate: [0, 0, 180] },
    { when: { north: "false", east: "true", west: "true", up: "false", down: "false" }, model: "pipe_cap" },
    { when: { north: "false", east: "false", west: "false", up: "true", down: "false" }, model: "pipe_cap", rotate: [0, 0, 90] },
    { when: { north: "false", east: "true", west: "false", up: "true", down: "false" }, model: "pipe_cap_bend", rotate: [0, 0, 270] },
    { when: { north: "false", east: "false", west: "true", up: "true", down: "false" }, model: "pipe_cap_bend" },
    { when: { north: "false", east: "true", west: "true", up: "true", down: "false" }, model: "pipe_cap_tee", rotate: [0, 0, 270] },
    { when: { north: "false", east: "false", west: "false", up: "false", down: "true" }, model: "pipe_cap", rotate: [0, 0, 270] },
    { when: { north: "false", east: "true", west: "false", up: "false", down: "true" }, model: "pipe_cap_bend", rotate: [0, 0, 180] },
    { when: { north: "false", east: "false", west: "true", up: "false", down: "true" }, model: "pipe_cap_bend", rotate: [0, 0, 90] },
    { when: { north: "false", east: "true", west: "true", up: "false", down: "true" }, model: "pipe_cap_tee", rotate: [0, 0, 90] },
    { when: { north: "false", east: "false", west: "false", up: "true", down: "true" }, model: "pipe_cap", rotate: [0, 0, 90] },
    { when: { north: "false", east: "true", west: "false", up: "true", down: "true" }, model: "pipe_cap_tee", rotate: [0, 0, 180] },
    { when: { north: "false", east: "false", west: "true", up: "true", down: "true" }, model: "pipe_cap_tee" },
    { when: { north: "false", east: "true", west: "true", up: "true", down: "true" }, model: "pipe_cap_cross" },
    { when: { south: "false", east: "false", west: "false", up: "false", down: "false" }, model: "pipe_cap_end", rotate: [0, 180, 0] },
    { when: { south: "false", east: "true", west: "false", up: "false", down: "false" }, model: "pipe_cap", rotate: [180, 0, 0] },
    { when: { south: "false", east: "false", west: "true", up: "false", down: "false" }, model: "pipe_cap", rotate: [0, 180, 0] },
    { when: { south: "false", east: "true", west: "true", up: "false", down: "false" }, model: "pipe_cap", rotate: [180, 0, 0] },
    { when: { south: "false", east: "false", west: "false", up: "true", down: "false" }, model: "pipe_cap", rotate: [180, 0, 90] },
    { when: { south: "false", east: "true", west: "false", up: "true", down: "false" }, model: "pipe_cap_bend", rotate: [0, 180, 0] },
    { when: { south: "false", east: "false", west: "true", up: "true", down: "false" }, model: "pipe_cap_bend", rotate: [0, 180, 90] },
