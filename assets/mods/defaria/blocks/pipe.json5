    { when: { east: "false", north: "false", south: "true", up: "true", down: "false" }, model: "pipe_cap_bend", rotate: [90, 0, 270] },
    { when: { east: "false", north: "true", south: "true", up: "true", down: "false" }, model: "pipe_cap_tee", rotate: [90, 0, 270] },
    { when: { east: "false", north: "false", south: "false", up: "false", down: "true" }, model: "pipe_cap", rotate: [90, 0, 270] },
    { when: { east: "false", north: "true", south: "false", up: "false", down: "true" }, model: "pipe_cap_bend", rotate: [270, 0, 90] },
    { when: { east: "false", north: "false", south: "true", up: "false", down: "true" }, model: "pipe_cap_bend", rotate: [0, 90, 180] },
