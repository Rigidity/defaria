// Pours its network's fluid into the world in front of it, a block a
// second, as much as fits in that voxel; flow spreads it from there (see
// "Fluid networks" in docs/modding.md). It faces you as you place it,
// so place it from where the fluid should go. Pipes join it on every
// other side: the iron sockets.
{
  name: "Outlet",
  properties: {
    // Facing you: the opposite of the way you look.
    facing: {
      values: ["north", "south", "east", "west"],
      place: { from: "look", values: { north: "south", south: "north", east: "west", west: "east" } },
    },
  },
  model: "cube",
  textures: { all: "fluid_port", north: "outlet_front" },
  variants: [
    { when: { facing: "south" }, rotate: [0, 180, 0] },
    { when: { facing: "west" }, rotate: [0, 90, 0] },
    { when: { facing: "east" }, rotate: [0, 270, 0] },
  ],
  hardness: 2,
  weight: 1500,
  category: "machines",
  // Blocks of fluid a second.
  stats: { outlet_rate: 1 },
  machine: {
    ports: [
      { faces: ["back", "left", "right", "up", "down"], network: "fluid", role: "input" },
    ],
    tanks: { fluid: { capacity: 1 } },
  },
}
