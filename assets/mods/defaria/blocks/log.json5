// A tree trunk: bark on the sides, rings on the ends. `axis` is the
// direction the trunk runs; the cube is turned so its ends face that way.
// A placed log runs along the face it's placed against. Every wood is its
// own item; the axis isn't part of the item.
{
  name: "{wood} Log",
  properties: {
    wood: { materials: "#wood", default: "oak" },
    axis: { values: ["y", "x", "z"], place: "face" },
  },
  model: "cube",
  textures: {
    side: { texture: "log_side", materials: { wood: "{wood}" } },
    end: { texture: "log_top", materials: { wood: "{wood}" } },
  },
  variants: [
    { when: { axis: "x" }, rotate: [0, 0, 90] },
    { when: { axis: "z" }, rotate: [90, 0, 0] },
  ],
  hardness: { materials: { wood: 1 } },
  weight: { materials: { wood: 1 } },
}
