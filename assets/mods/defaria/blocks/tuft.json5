// A tuft of grass, drawn as two crossed quads. It grows on grass in the
// terrain, and stands on grass, or bare dirt or loam.
{
  name: "Grass Tuft",
  model: "cross",
  render: "cutout",
  textures: { all: "tuft" },
  hardness: 0.05,
  weight: 0.05,
  category: "natural",
  // Dirt or loam, grassy or bare, and any soil under grass.
  support: [
    { block: "soil", when: { soil: ["dirt", "loam"] } },
    { block: "soil", when: { turf: "grass" } },
  ],
}
