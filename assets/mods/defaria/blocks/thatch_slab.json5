{
  name: "Thatch Slab",
  properties: {
    // Which half of its voxel it fills: on top of a block it sits low,
    // under one it sits high, and against a block's side it sits low too.
    // Vertical slabs are blocks of their own (`*_vertical_slab`).
    half: {
      values: ["bottom", "top"],
      place: { from: "face", values: { up: "bottom", down: "top" } },
    },
  },
  model: "slab_{half}",
  textures: { all: "thatch" },
  hardness: 0.4,
  weight: 125,
  category: "building",
}
