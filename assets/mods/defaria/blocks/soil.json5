// Loose ground: a soil (dirt, sand, gravel, or any `#soil` material), with
// or without a turf (grass, or any `#turf` material) growing on it. Turf
// covers the top and hangs over the edge of the sides; the bottom is bare
// soil. A mod adds a soil with just a material tagged `soil` and an image
// of the same name.
{
  name: "{soil}",
  properties: {
    soil: { materials: ["dirt", "#soil"] },
    turf: { materials: "#turf", optional: true },
  },
  model: "cube",
  textures: { all: { texture: "soil", materials: { soil: "{soil}" } } },
  variants: [
    {
      when: { turf: { not: "none" } },
      name: "{soil} with {turf}",
      textures: {
        up: { texture: "turf", materials: { turf: "{turf}" } },
        side: { texture: "soil_turf", materials: { soil: "{soil}", turf: "{turf}" } },
      },
    },
  ],
  // Mostly soil: the turf counts a quarter.
  hardness: { materials: { soil: 3, turf: 1 } },
  weight: { materials: { soil: 3, turf: 1 } },
}
