// A metal wire, on the electric network: a thin strip lying flat on the
// side of its voxel it rests against (`on`: the floor, a wall or the
// ceiling, the face it was placed against), with an arm along that side
// to each side it's joined on there, and a riser straight out to the
// middle of the far side when it's joined that way. Joined toward what it
// rests on, nothing more is drawn: the wire already touches it. A wire
// joined to one resting on another side bends to meet it, by the parts
// drawn by their neighbours (`next`): see scripts/wire-models.py, which
// writes the models and this list of parts. You bump into a wire and aim
// at it as it's drawn, bends too; aimed at, a part is the wrench's for
// the side its `when` joins.
// Wires join wires (any conduit on the electric network), not pipes.
{
  name: "{metal} Wire",
  properties: {
    metal: { materials: "#metal", default: "copper" },
    on: {
      values: ["down", "up", "north", "south", "east", "west"],
      place: {
        from: "face",
        values: { up: "down", down: "up", north: "south", south: "north", east: "west", west: "east" },
      },
    },
    connect: { connections: true },
  },
  // It rests on a solid face on the side it lies on: it's only placed
  // against one, and breaks when that face goes.
  support: { side: "{on}", solid: true },
  textures: {
    wire: { texture: "wire", materials: { metal: "{metal}" } },
  },
  parts: [
    // On the floor.
    { when: { on: "down" }, model: "wire_core" },
    { when: { on: "down", up: "true" }, model: "wire_riser", next: { up: { not: { block: "wire", when: { on: ["north", "south", "east", "west"] } } } } },
    { when: { on: "down", up: "true" }, model: "wire_climb", next: { up: { block: "wire", when: { on: "north" } } } },
    { when: { on: "down", up: "true" }, model: "wire_climb", rotate: [0, 180, 0], next: { up: { block: "wire", when: { on: "south" } } } },
    { when: { on: "down", up: "true" }, model: "wire_climb", rotate: [0, 270, 0], next: { up: { block: "wire", when: { on: "east" } } } },
    { when: { on: "down", up: "true" }, model: "wire_climb", rotate: [0, 90, 0], next: { up: { block: "wire", when: { on: "west" } } } },
    { when: { on: "down", north: "true" }, model: "wire_arm" },
    { when: { on: "down", south: "true" }, model: "wire_arm", rotate: [0, 180, 0] },
    { when: { on: "down", east: "true" }, model: "wire_arm", rotate: [0, 270, 0] },
    { when: { on: "down", west: "true" }, model: "wire_arm", rotate: [0, 90, 0] },
    // On the ceiling.
    { when: { on: "up" }, model: "wire_core", rotate: [0, 0, 180] },
    { when: { on: "up", down: "true" }, model: "wire_riser", rotate: [0, 0, 180], next: { down: { not: { block: "wire", when: { on: ["north", "south", "east", "west"] } } } } },
    { when: { on: "up", down: "true" }, model: "wire_climb", rotate: [0, 0, 180], next: { down: { block: "wire", when: { on: "north" } } } },
    { when: { on: "up", down: "true" }, model: "wire_climb", rotate: [180, 0, 0], next: { down: { block: "wire", when: { on: "south" } } } },
    { when: { on: "up", down: "true" }, model: "wire_climb", rotate: [0, 90, 180], next: { down: { block: "wire", when: { on: "east" } } } },
    { when: { on: "up", down: "true" }, model: "wire_climb", rotate: [0, 270, 180], next: { down: { block: "wire", when: { on: "west" } } } },
    { when: { on: "up", north: "true" }, model: "wire_arm", rotate: [0, 0, 180], next: { north: { not: { block: "wire", when: { on: ["down"] } } } } },
    { when: { on: "up", north: "true" }, model: "wire_riser", rotate: [0, 0, 180], next: { north: { block: "wire", when: { on: "down" } } } },
    { when: { on: "up", north: "true" }, model: "wire_arm", next: { north: { block: "wire", when: { on: "down" } } } },
    { when: { on: "up", south: "true" }, model: "wire_arm", rotate: [180, 0, 0], next: { south: { not: { block: "wire", when: { on: ["down"] } } } } },
    { when: { on: "up", south: "true" }, model: "wire_riser", rotate: [0, 0, 180], next: { south: { block: "wire", when: { on: "down" } } } },
    { when: { on: "up", south: "true" }, model: "wire_arm", rotate: [0, 180, 0], next: { south: { block: "wire", when: { on: "down" } } } },
    { when: { on: "up", east: "true" }, model: "wire_arm", rotate: [0, 90, 180], next: { east: { not: { block: "wire", when: { on: ["down"] } } } } },
    { when: { on: "up", east: "true" }, model: "wire_riser", rotate: [0, 0, 180], next: { east: { block: "wire", when: { on: "down" } } } },
    { when: { on: "up", east: "true" }, model: "wire_arm", rotate: [0, 270, 0], next: { east: { block: "wire", when: { on: "down" } } } },
    { when: { on: "up", west: "true" }, model: "wire_arm", rotate: [0, 270, 180], next: { west: { not: { block: "wire", when: { on: ["down"] } } } } },
    { when: { on: "up", west: "true" }, model: "wire_riser", rotate: [0, 0, 180], next: { west: { block: "wire", when: { on: "down" } } } },
    { when: { on: "up", west: "true" }, model: "wire_arm", rotate: [0, 90, 0], next: { west: { block: "wire", when: { on: "down" } } } },
    // On the north wall.
    { when: { on: "north" }, model: "wire_core", rotate: [90, 0, 0] },
    { when: { on: "north", down: "true" }, model: "wire_arm", rotate: [90, 0, 180] },
    { when: { on: "north", up: "true" }, model: "wire_arm", rotate: [90, 0, 0] },
    { when: { on: "north", south: "true" }, model: "wire_riser", rotate: [90, 0, 0], next: { south: { not: { block: "wire", when: { on: ["down", "up", "east", "west"] } } } } },
    { when: { on: "north", south: "true" }, model: "wire_climb", rotate: [90, 0, 180], next: { south: { block: "wire", when: { on: "down" } } } },
    { when: { on: "north", south: "true" }, model: "wire_climb", rotate: [90, 0, 0], next: { south: { block: "wire", when: { on: "up" } } } },
    { when: { on: "north", south: "true" }, model: "wire_climb", rotate: [90, 0, 270], next: { south: { block: "wire", when: { on: "east" } } } },
    { when: { on: "north", south: "true" }, model: "wire_climb", rotate: [90, 0, 90], next: { south: { block: "wire", when: { on: "west" } } } },
    { when: { on: "north", east: "true" }, model: "wire_arm", rotate: [90, 0, 270], next: { east: { not: { block: "wire", when: { on: ["down", "up"] } } } } },
    { when: { on: "north", east: "true" }, model: "wire_arm", rotate: [90, 0, 180], next: { east: { block: "wire", when: { on: "down" } } } },
    { when: { on: "north", east: "true" }, model: "wire_core", next: { east: { block: "wire", when: { on: "down" } } } },
    { when: { on: "north", east: "true" }, model: "wire_arm", next: { east: { block: "wire", when: { on: "down" } } } },
    { when: { on: "north", east: "true" }, model: "wire_arm", rotate: [0, 270, 0], next: { east: { block: "wire", when: { on: "down" } } } },
    { when: { on: "north", east: "true" }, model: "wire_arm", rotate: [90, 0, 0], next: { east: { block: "wire", when: { on: "up" } } } },
    { when: { on: "north", east: "true" }, model: "wire_core", rotate: [0, 0, 180], next: { east: { block: "wire", when: { on: "up" } } } },
    { when: { on: "north", east: "true" }, model: "wire_arm", rotate: [0, 0, 180], next: { east: { block: "wire", when: { on: "up" } } } },
    { when: { on: "north", east: "true" }, model: "wire_arm", rotate: [0, 90, 180], next: { east: { block: "wire", when: { on: "up" } } } },
    { when: { on: "north", west: "true" }, model: "wire_arm", rotate: [90, 0, 90], next: { west: { not: { block: "wire", when: { on: ["down", "up"] } } } } },
    { when: { on: "north", west: "true" }, model: "wire_arm", rotate: [90, 0, 180], next: { west: { block: "wire", when: { on: "down" } } } },
    { when: { on: "north", west: "true" }, model: "wire_core", next: { west: { block: "wire", when: { on: "down" } } } },
    { when: { on: "north", west: "true" }, model: "wire_arm", next: { west: { block: "wire", when: { on: "down" } } } },
    { when: { on: "north", west: "true" }, model: "wire_arm", rotate: [0, 90, 0], next: { west: { block: "wire", when: { on: "down" } } } },
    { when: { on: "north", west: "true" }, model: "wire_arm", rotate: [90, 0, 0], next: { west: { block: "wire", when: { on: "up" } } } },
    { when: { on: "north", west: "true" }, model: "wire_core", rotate: [0, 0, 180], next: { west: { block: "wire", when: { on: "up" } } } },
    { when: { on: "north", west: "true" }, model: "wire_arm", rotate: [0, 0, 180], next: { west: { block: "wire", when: { on: "up" } } } },
    { when: { on: "north", west: "true" }, model: "wire_arm", rotate: [0, 270, 180], next: { west: { block: "wire", when: { on: "up" } } } },
    // On the south wall.
    { when: { on: "south" }, model: "wire_core", rotate: [270, 0, 0] },
    { when: { on: "south", down: "true" }, model: "wire_arm", rotate: [270, 0, 0], next: { down: { not: { block: "wire", when: { on: ["north"] } } } } },
    { when: { on: "south", down: "true" }, model: "wire_riser", rotate: [270, 0, 0], next: { down: { block: "wire", when: { on: "north" } } } },
    { when: { on: "south", down: "true" }, model: "wire_arm", rotate: [90, 0, 180], next: { down: { block: "wire", when: { on: "north" } } } },
    { when: { on: "south", up: "true" }, model: "wire_arm", rotate: [90, 180, 0], next: { up: { not: { block: "wire", when: { on: ["north"] } } } } },
    { when: { on: "south", up: "true" }, model: "wire_riser", rotate: [270, 0, 0], next: { up: { block: "wire", when: { on: "north" } } } },
    { when: { on: "south", up: "true" }, model: "wire_arm", rotate: [90, 0, 0], next: { up: { block: "wire", when: { on: "north" } } } },
