// A metal wire, on the electric network: a small knot with a thin arm out
// to each side it's joined on, drawn like the pipe at half its width.
// Wires join wires (any conduit on the electric network), not pipes.
{
  name: "{metal} Wire",
  properties: {
    metal: { materials: "#metal", default: "copper" },
    connect: { connections: true },
  },
  textures: {
    all: { texture: "wire_core", materials: { metal: "{metal}" } },
    side: { texture: "wire", materials: { metal: "{metal}" } },
    end: { texture: "wire", materials: { metal: "{metal}" } },
  },
  parts: [
    { model: "wire_core" },
    { when: { north: "true" }, model: "wire_arm" },
    { when: { south: "true" }, model: "wire_arm", rotate: [0, 180, 0] },
    { when: { west: "true" }, model: "wire_arm", rotate: [0, 90, 0] },
    { when: { east: "true" }, model: "wire_arm", rotate: [0, 270, 0] },
    { when: { up: "true" }, model: "wire_arm", rotate: [90, 0, 0] },
    { when: { down: "true" }, model: "wire_arm", rotate: [270, 0, 0] },
  ],
  render: "cutout",
  hardness: { base: 0.2, materials: { metal: 1 } },
  weight: { base: 0.02, materials: { metal: 1 } },
  category: "building",
  // A wire holds no energy; it passes 1000 units a second for each unit
  // of its metal's conductivity (copper 1000, iron 170).
  conduit: {
    network: "electric",
    capacity: 0,
    throughput: { base: 1000, stat: "conductivity", materials: { metal: 1 } },
  },
}
