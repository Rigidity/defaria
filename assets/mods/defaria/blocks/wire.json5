    { when: { on: "south", north: "true" }, model: "wire_climb", rotate: [270, 0, 90], next: { north: { block: "wire", when: { on: "east" } } } },
    { when: { on: "south", north: "true" }, model: "wire_climb", rotate: [270, 0, 270], next: { north: { block: "wire", when: { on: "west" } } } },
    { when: { on: "south", east: "true" }, model: "wire_arm", rotate: [270, 0, 90], next: { east: { not: { block: "wire", when: { on: ["down", "up", "north"] } } } } },
    { when: { on: "south", east: "true" }, model: "wire_arm", rotate: [270, 0, 0], next: { east: { block: "wire", when: { on: "down" } } } },
    { when: { on: "south", east: "true" }, model: "wire_core", next: { east: { block: "wire", when: { on: "down" } } } },
    { when: { on: "south", east: "true" }, model: "wire_arm", rotate: [0, 180, 0], next: { east: { block: "wire", when: { on: "down" } } } },
    { when: { on: "south", east: "true" }, model: "wire_arm", rotate: [0, 270, 0], next: { east: { block: "wire", when: { on: "down" } } } },
    { when: { on: "south", east: "true" }, model: "wire_arm", rotate: [90, 180, 0], next: { east: { block: "wire", when: { on: "up" } } } },
    { when: { on: "south", east: "true" }, model: "wire_core", rotate: [0, 0, 180], next: { east: { block: "wire", when: { on: "up" } } } },
    { when: { on: "south", east: "true" }, model: "wire_arm", rotate: [180, 0, 0], next: { east: { block: "wire", when: { on: "up" } } } },
    { when: { on: "south", east: "true" }, model: "wire_arm", rotate: [0, 90, 180], next: { east: { block: "wire", when: { on: "up" } } } },
    { when: { on: "south", east: "true" }, model: "wire_riser", rotate: [270, 0, 0], next: { east: { block: "wire", when: { on: "north" } } } },
    { when: { on: "south", east: "true" }, model: "wire_arm", rotate: [90, 0, 270], next: { east: { block: "wire", when: { on: "north" } } } },
    { when: { on: "south", west: "true" }, model: "wire_arm", rotate: [270, 0, 270], next: { west: { not: { block: "wire", when: { on: ["down", "up", "north"] } } } } },
    { when: { on: "south", west: "true" }, model: "wire_arm", rotate: [270, 0, 0], next: { west: { block: "wire", when: { on: "down" } } } },
    { when: { on: "south", west: "true" }, model: "wire_core", next: { west: { block: "wire", when: { on: "down" } } } },
    { when: { on: "south", west: "true" }, model: "wire_arm", rotate: [0, 180, 0], next: { west: { block: "wire", when: { on: "down" } } } },
    { when: { on: "south", west: "true" }, model: "wire_arm", rotate: [0, 90, 0], next: { west: { block: "wire", when: { on: "down" } } } },
    { when: { on: "south", west: "true" }, model: "wire_arm", rotate: [90, 180, 0], next: { west: { block: "wire", when: { on: "up" } } } },
