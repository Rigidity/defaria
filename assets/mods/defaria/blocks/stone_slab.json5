{
  name: "{rock} Slab",
  properties: {
    // Which half of its voxel it fills: on top of a block it sits low,
    // under one it sits high, and against a block's side in the half you
    // click. Vertical slabs are blocks of their own (`*_vertical_slab`).
    half: {
      values: ["bottom", "top"],
      place: { from: "nearest", values: { down: "bottom", up: "top" } },
    },
    rock: { materials: "#rock", default: "stone" },
  },
  model: "slab_{half}",
  textures: { all: { texture: "stone", materials: { rock: "{rock}" } } },
  hardness: { materials: { rock: 1 } },
  weight: { base: 0.5, materials: { rock: 1 } },
  // Water fills the half of its cell it leaves.
  fluid_room: 0.5,
  category: "building",
}
