// A metal or rock head on a wooden handle; each pair is its own item. A
// rock head is knapped stone, drawn chunkier than a metal one.
{
  name: "{head} Axe",
  properties: {
    head: { materials: ["#metal", "#rock"], default: "iron" },
    handle: { materials: "#wood", default: "oak" },
  },
  texture: { texture: "axe", materials: { head: "{head}", handle: "{handle}" } },
  variants: [
    {
      when: { head: "#rock" },
      texture: { texture: "axe_rock", materials: { head: "{head}", handle: "{handle}" } },
    },
  ],
  unique: true,
  // Mostly as hard as its head.
  hardness: { materials: { head: 3, handle: 1 } },
  // 0.6 litres in all, head to handle 1 to 3 by volume.
  weight: { base: 0.0006, materials: { head: 1, handle: 3 } },
  category: "tools",
}
