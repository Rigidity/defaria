// A metal head on a wooden handle; each pair is its own item.
{
  name: "{head} Shovel",
  properties: {
    head: { materials: "#metal", default: "iron" },
    handle: { materials: "#wood", default: "oak" },
  },
  texture: { texture: "shovel", materials: { head: "{head}", handle: "{handle}" } },
  max_stack: 1,
  // Mostly as hard as its head.
  hardness: { materials: { head: 3, handle: 1 } },
  // 0.6 litres in all, head to handle 1 to 4 by volume.
  weight: { base: 0.0006, materials: { head: 1, handle: 4 } },
}
