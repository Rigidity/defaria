// A metal head on a wooden handle; each pair is its own item.
{
  name: "{head} Sword",
  properties: {
    head: { materials: "#metal", default: "iron" },
    handle: { materials: "#wood", default: "oak" },
  },
  texture: { texture: "sword", materials: { head: "{head}", handle: "{handle}" } },
  unique: true,
  // Mostly as hard as its head.
  hardness: { materials: { head: 3, handle: 1 } },
  // 0.2 litres in all, head to handle 3 to 1 by volume.
  weight: { base: 0.0002, materials: { head: 3, handle: 1 } },
}
