// A metal head on a wooden handle; each pair is its own item.
{
  name: "{head} Knife",
  properties: {
    head: { materials: "#metal", default: "iron" },
    handle: { materials: "#wood", default: "oak" },
  },
  texture: { texture: "knife", materials: { head: "{head}", handle: "{handle}" } },
  unique: true,
  // Mostly as hard as its head.
  hardness: { materials: { head: 3, handle: 1 } },
  // 0.05 litres in all, head to handle 1 to 1 by volume.
  weight: { base: 0.00005, materials: { head: 1, handle: 1 } },
  category: "tools",
}
