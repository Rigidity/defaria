// A metal head on a wooden handle; each pair is its own item.
{
  name: "{head} Knife ({handle})",
  properties: {
    head: { materials: ["iron", "#metal"] },
    handle: { materials: ["oak", "#wood"] },
  },
  texture: { texture: "knife", materials: { head: "{head}", handle: "{handle}" } },
  max_stack: 1,
}
